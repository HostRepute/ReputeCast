{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReputeCast chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": { "type": "object" },
        "limits": { "type": "object" },
        "claims": { "type": "array" }
      }
    },
    "secretName": {
      "type": "string",
      "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$",
      "maxLength": 253
    },
    "secretKey": { "type": "string", "pattern": "^[-._a-zA-Z0-9]+$" },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "stringMap": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "properties": {
    "global": { "type": "object" },
    "publicURL": {
      "type": "string",
      "description": "The address people and sending providers reach, such as https://news.example.com."
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string" } }
      }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "mode": {
      "enum": ["single", "split"],
      "description": "single: one StatefulSet runs every role; split: web, worker (and ingest) Deployments, which need storage.backend s3."
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "pattern": "^((postgres|postgresql)://.+)?$" },
        "existingSecret": { "$ref": "#/definitions/secretName" },
        "existingSecretKey": { "$ref": "#/definitions/secretKey" }
      }
    },
    "secretKey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "$ref": "#/definitions/secretName" },
        "existingSecretKey": { "$ref": "#/definitions/secretKey" }
      }
    },
    "admin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "email": { "type": "string", "pattern": "^([^@\\s]+@[^@\\s]+)?$" },
        "name": { "type": "string" },
        "passwordSecret": { "$ref": "#/definitions/secretName" },
        "passwordSecretKey": { "$ref": "#/definitions/secretKey" }
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": { "type": "integer", "minimum": 0 },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "ingest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "separate": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 1 },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend": { "enum": ["local", "s3"] },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bucket": { "type": "string" },
            "region": { "type": "string" },
            "endpoint": { "type": "string", "pattern": "^(https?://[^/\\s]+.*)?$" },
            "pathStyle": { "type": "boolean" },
            "prefix": { "type": "string", "pattern": "^([^/].*)?$" },
            "sse": { "enum": ["", "AES256", "aws:kms"] },
            "kmsKeyID": { "type": "string" },
            "accessKeyID": { "type": "string" },
            "secretAccessKey": { "type": "string" },
            "existingSecret": { "$ref": "#/definitions/secretName" },
            "accessKeyIDKey": { "$ref": "#/definitions/secretKey" },
            "secretAccessKeyKey": { "$ref": "#/definitions/secretKey" }
          }
        }
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trustedProxies": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": { "enum": ["debug", "info", "warn", "error"] }
      }
    },
    "geoip": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "volume": { "type": "object", "description": "A volume source holding the MaxMind DB file; empty is off." },
        "file": { "type": "string", "pattern": "^[^/]+$" }
      }
    },
    "smtpRelay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "type": { "enum": ["LoadBalancer", "NodePort", "ClusterIP"] },
            "annotations": { "$ref": "#/definitions/stringMap" },
            "externalTrafficPolicy": { "enum": ["", "Local", "Cluster"] },
            "loadBalancerSourceRanges": { "type": "array", "items": { "type": "string" } }
          }
        },
        "starttlsPort": { "$ref": "#/definitions/port" },
        "tlsPort": { "$ref": "#/definitions/port" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "$ref": "#/definitions/port" },
        "annotations": { "$ref": "#/definitions/stringMap" }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "hosts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "secretName": { "type": "string" },
              "hosts": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "storageClass": { "type": "string" },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["ReadWriteOnce", "ReadWriteOncePod", "ReadWriteMany", "ReadOnlyMany"] }
        },
        "size": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei|k|M|G|T|P|E)?$" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "existingClaim": { "type": "string" }
      }
    },
    "resources": { "$ref": "#/definitions/resources" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "automount": { "type": "boolean" }
      }
    },
    "podAnnotations": { "$ref": "#/definitions/stringMap" },
    "podLabels": { "$ref": "#/definitions/stringMap" },
    "nodeSelector": { "$ref": "#/definitions/stringMap" },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array", "items": { "type": "object" } },
    "priorityClassName": { "type": "string" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string" },
        "scrapeTimeout": { "type": "string" },
        "labels": { "$ref": "#/definitions/stringMap" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "httpFrom": { "type": "array", "items": { "type": "object" } },
        "metricsFrom": { "type": "array", "items": { "type": "object" } },
        "extraIngress": { "type": "array", "items": { "type": "object" } }
      }
    },
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "maxUnavailable": { "type": ["integer", "string"] }
      }
    },
    "hpa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "extraEnv": {
      "type": "array",
      "items": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" } } }
    },
    "extraEnvFrom": { "type": "array", "items": { "type": "object" } }
  }
}
