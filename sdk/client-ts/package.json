{
  "name": "@reputecast/client",
  "version": "0.0.0-dev",
  "description": "The ReputeCast API client for TypeScript and JavaScript: typed requests, retries, RFC 9457 errors, pagination and webhook verification.",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/hostrepute/reputecast/blob/main/docs/api/README.md#client-sdks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hostrepute/reputecast.git",
    "directory": "sdk/client-ts"
  },
  "keywords": [
    "reputecast",
    "newsletter",
    "email",
    "api",
    "sdk"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "openapi-typescript ../openapi/public.json -o src/schema.d.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('src/schema.d.ts', 'dist/schema.d.ts')\"",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
