{
  "name": "example-esp-adapter",
  "private": true,
  "version": "0.1.0",
  "description": "ReputeCast community adapter for Example ESP: the template to start your own adapter from.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "start": "node --preserve-symlinks --permission --allow-fs-read=. dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run && reputecast-adapter test"
  },
  "dependencies": {
    "@reputecast/adapter-sdk": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
