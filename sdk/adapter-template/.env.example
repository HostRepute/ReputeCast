# Copy to .env for `pnpm dev`.
# The signing secret ReputeCast printed for this adapter
# (reputecast adapter install … or reputecast adapter secret example-esp).
REPUTECAST_ADAPTER_SECRET=
PORT=4600
HOST=127.0.0.1
# Point the adapter at another Example ESP endpoint (a regional one, a fake).
# EXAMPLE_ESP_API_URL=https://api.example-esp.com
