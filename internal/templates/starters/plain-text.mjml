<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Georgia, 'Times New Roman', serif"></mj-all>
      <mj-text color="#1F2937" font-size="15px" line-height="1.6" padding="0px 0px 14px"></mj-text>
    </mj-attributes>
  </mj-head>
  <mj-body width="600px" background-color="#ffffff">
    <mj-section background-color="#ffffff" padding="28px 24px 12px">
      <mj-column>
        <mj-text>%%T:plain.greeting%%</mj-text>
        <mj-text>%%T:plain.write%%</mj-text>
        <mj-text>%%T:plain.detail%%</mj-text>
        <mj-text>%%T:plain.signoff%%<br>%%T:plain.signature%%</mj-text>
      </mj-column>
    </mj-section>
    <!-- rc:footer -->
    <mj-section background-color="#ffffff" padding="12px 24px 24px" border-top="1px solid #EEF0F3">
      <mj-column>
        <mj-text align="left" font-family="'IBM Plex Sans', Helvetica, Arial, sans-serif" font-size="12px" line-height="1.6" color="#5B6472" padding="0px">%%ADDRESS%%<br><a href="{{ unsubscribe_url }}" style="color:#0F766E;text-decoration:none">%%T:footer.unsubscribe%%</a> · <a href="{{ preferences_url }}" style="color:#0F766E;text-decoration:none">%%T:footer.preferences%%</a></mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
