<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Georgia, 'Times New Roman', serif"></mj-all>
      <mj-text color="#1F2937" padding="0px"></mj-text>
    </mj-attributes>
  </mj-head>
  <mj-body width="600px" background-color="#F3F4F6">
    <!-- rc:header-logo -->
    <mj-section background-color="#ffffff" padding="20px 24px" border-bottom="1px solid #EEF0F3">
      <mj-column width="40%" vertical-align="middle">
        <mj-image src="rc-asset:logo.png" alt="Your logo" width="120px" align="left" padding="0px"></mj-image>
      </mj-column>
      <mj-column width="60%" vertical-align="middle">
        <mj-text align="right" font-family="'IBM Plex Sans', Helvetica, Arial, sans-serif" font-size="12px" color="#5B6472"><a href="https://example.com/blog" style="color:#5B6472;text-decoration:none">Blog</a> · <a href="https://example.com/docs" style="color:#5B6472;text-decoration:none">Docs</a> · <a href="https://example.com/changelog" style="color:#5B6472;text-decoration:none">Changelog</a></mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="20px 24px 8px">
      <mj-column>
        <mj-image src="rc-asset:hero.png" alt="Describe the hero image" width="552px" padding="0px 0px 16px"></mj-image>
        <mj-text font-size="26px" line-height="1.2" font-weight="700" color="#0B1220" padding="0px 0px 10px">A headline that says what's inside this week</mj-text>
        <mj-text font-size="15px" line-height="1.55">Hi {{ first_name | default: "there" }}, two or three sentences on what this issue covers and why it matters to the reader.</mj-text>
      </mj-column>
    </mj-section>
    <!-- rc:article-cards -->
    <mj-section background-color="#ffffff" padding="16px 24px">
      <mj-column width="50%" padding="0px 8px 0px 0px">
        <mj-image src="rc-asset:card.png" alt="Describe the first article's image" width="268px" padding="0px 0px 10px"></mj-image>
        <mj-text font-size="17px" line-height="1.3" font-weight="700" color="#0B1220" padding="0px 0px 6px">First article title</mj-text>
        <mj-text font-size="14px" line-height="1.5" color="#374151" padding="0px 0px 10px">One or two sentences that make people want to read the rest.</mj-text>
        <mj-button href="https://example.com/article-1" align="left" background-color="#0F766E" color="#ffffff" font-family="'IBM Plex Sans', Helvetica, Arial, sans-serif" font-size="13px" font-weight="600" border-radius="6px" inner-padding="9px 14px" padding="0px">Read more</mj-button>
      </mj-column>
      <mj-column width="50%" padding="0px 0px 0px 8px">
        <mj-image src="rc-asset:card.png" alt="Describe the second article's image" width="268px" padding="0px 0px 10px"></mj-image>
        <mj-text font-size="17px" line-height="1.3" font-weight="700" color="#0B1220" padding="0px 0px 6px">Second article title</mj-text>
        <mj-text font-size="14px" line-height="1.5" color="#374151" padding="0px 0px 10px">One or two sentences that make people want to read the rest.</mj-text>
        <mj-button href="https://example.com/article-2" align="left" background-color="#0F766E" color="#ffffff" font-family="'IBM Plex Sans', Helvetica, Arial, sans-serif" font-size="13px" font-weight="600" border-radius="6px" inner-padding="9px 14px" padding="0px">Read more</mj-button>
      </mj-column>
    </mj-section>
    <!-- rc:footer -->
    <mj-section background-color="#F3F4F6" padding="18px 24px">
      <mj-column>
        <mj-text align="center" font-family="'IBM Plex Sans', Helvetica, Arial, sans-serif" font-size="12px" line-height="1.6" color="#5B6472" padding="0px">%%ADDRESS%%<br><a href="{{ unsubscribe_url }}" style="color:#0F766E;text-decoration:none">Unsubscribe</a> · <a href="{{ preferences_url }}" style="color:#0F766E;text-decoration:none">Email preferences</a> · <a href="{{ view_in_browser_url }}" style="color:#0F766E;text-decoration:none">View in browser</a></mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
