<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Georgia, 'Times New Roman', serif"></mj-all>
      <mj-text color="#1F2937" padding="0px"></mj-text>
    </mj-attributes>
  </mj-head>
  <mj-body width="600px" background-color="#F3F4F6">
    <!-- rc:product-cards -->
    <mj-section background-color="#ffffff" padding="20px 18px 8px">
      <mj-column width="33.33%" padding="0px 6px">
        <mj-image src="rc-asset:product.png" alt="%%T:grid.productAlt|n=1%%" width="168px" padding="0px 0px 8px"></mj-image>
        <mj-text font-size="15px" line-height="1.3" font-weight="700" color="#0B1220" padding="0px 0px 4px">%%T:grid.productName%%</mj-text>
        <mj-text font-size="13px" line-height="1.5" color="#374151" padding="0px 0px 8px">%%T:grid.productLine|price=$29%%</mj-text>
        <mj-button href="https://example.com/product-1" align="left" background-color="#0F766E" color="#ffffff" font-family="'IBM Plex Sans', Helvetica, Arial, sans-serif" font-size="12px" font-weight="600" border-radius="6px" inner-padding="8px 12px" padding="0px">%%T:grid.view%%</mj-button>
      </mj-column>
      <mj-column width="33.33%" padding="0px 6px">
        <mj-image src="rc-asset:product.png" alt="%%T:grid.productAlt|n=2%%" width="168px" padding="0px 0px 8px"></mj-image>
        <mj-text font-size="15px" line-height="1.3" font-weight="700" color="#0B1220" padding="0px 0px 4px">%%T:grid.productName%%</mj-text>
        <mj-text font-size="13px" line-height="1.5" color="#374151" padding="0px 0px 8px">%%T:grid.productLine|price=$49%%</mj-text>
        <mj-button href="https://example.com/product-2" align="left" background-color="#0F766E" color="#ffffff" font-family="'IBM Plex Sans', Helvetica, Arial, sans-serif" font-size="12px" font-weight="600" border-radius="6px" inner-padding="8px 12px" padding="0px">%%T:grid.view%%</mj-button>
      </mj-column>
      <mj-column width="33.33%" padding="0px 6px">
        <mj-image src="rc-asset:product.png" alt="%%T:grid.productAlt|n=3%%" width="168px" padding="0px 0px 8px"></mj-image>
        <mj-text font-size="15px" line-height="1.3" font-weight="700" color="#0B1220" padding="0px 0px 4px">%%T:grid.productName%%</mj-text>
        <mj-text font-size="13px" line-height="1.5" color="#374151" padding="0px 0px 8px">%%T:grid.productLine|price=$99%%</mj-text>
        <mj-button href="https://example.com/product-3" align="left" background-color="#0F766E" color="#ffffff" font-family="'IBM Plex Sans', Helvetica, Arial, sans-serif" font-size="12px" font-weight="600" border-radius="6px" inner-padding="8px 12px" padding="0px">%%T:grid.view%%</mj-button>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="8px 24px">
      <mj-column>
        <mj-text font-size="15px" line-height="1.55">%%T:grid.intro%%</mj-text>
      </mj-column>
    </mj-section>
    <!-- rc:product-cards -->
    <mj-section background-color="#ffffff" padding="8px 18px 24px">
      <mj-column width="33.33%" padding="0px 6px">
        <mj-image src="rc-asset:product.png" alt="%%T:grid.productAlt|n=4%%" width="168px" padding="0px 0px 8px"></mj-image>
        <mj-text font-size="15px" line-height="1.3" font-weight="700" color="#0B1220" padding="0px 0px 4px">%%T:grid.productName%%</mj-text>
        <mj-text font-size="13px" line-height="1.5" color="#374151" padding="0px 0px 8px">%%T:grid.productLine|price=$19%%</mj-text>
        <mj-button href="https://example.com/product-4" align="left" background-color="#0F766E" color="#ffffff" font-family="'IBM Plex Sans', Helvetica, Arial, sans-serif" font-size="12px" font-weight="600" border-radius="6px" inner-padding="8px 12px" padding="0px">%%T:grid.view%%</mj-button>
      </mj-column>
      <mj-column width="33.33%" padding="0px 6px">
        <mj-image src="rc-asset:product.png" alt="%%T:grid.productAlt|n=5%%" width="168px" padding="0px 0px 8px"></mj-image>
        <mj-text font-size="15px" line-height="1.3" font-weight="700" color="#0B1220" padding="0px 0px 4px">%%T:grid.productName%%</mj-text>
        <mj-text font-size="13px" line-height="1.5" color="#374151" padding="0px 0px 8px">%%T:grid.productLine|price=$39%%</mj-text>
        <mj-button href="https://example.com/product-5" align="left" background-color="#0F766E" color="#ffffff" font-family="'IBM Plex Sans', Helvetica, Arial, sans-serif" font-size="12px" font-weight="600" border-radius="6px" inner-padding="8px 12px" padding="0px">%%T:grid.view%%</mj-button>
      </mj-column>
      <mj-column width="33.33%" padding="0px 6px">
        <mj-image src="rc-asset:product.png" alt="%%T:grid.productAlt|n=6%%" width="168px" padding="0px 0px 8px"></mj-image>
        <mj-text font-size="15px" line-height="1.3" font-weight="700" color="#0B1220" padding="0px 0px 4px">%%T:grid.productName%%</mj-text>
        <mj-text font-size="13px" line-height="1.5" color="#374151" padding="0px 0px 8px">%%T:grid.productLine|price=$59%%</mj-text>
        <mj-button href="https://example.com/product-6" align="left" background-color="#0F766E" color="#ffffff" font-family="'IBM Plex Sans', Helvetica, Arial, sans-serif" font-size="12px" font-weight="600" border-radius="6px" inner-padding="8px 12px" padding="0px">%%T:grid.view%%</mj-button>
      </mj-column>
    </mj-section>
    <!-- rc:footer -->
    <mj-section background-color="#F3F4F6" padding="18px 24px">
      <mj-column>
        <mj-text align="center" font-family="'IBM Plex Sans', Helvetica, Arial, sans-serif" font-size="12px" line-height="1.6" color="#5B6472" padding="0px">%%ADDRESS%%<br><a href="{{ unsubscribe_url }}" style="color:#0F766E;text-decoration:none">%%T:footer.unsubscribe%%</a> · <a href="{{ preferences_url }}" style="color:#0F766E;text-decoration:none">%%T:footer.preferences%%</a> · <a href="{{ view_in_browser_url }}" style="color:#0F766E;text-decoration:none">%%T:footer.viewInBrowser%%</a></mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
