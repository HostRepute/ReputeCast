<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Georgia, 'Times New Roman', serif"></mj-all>
      <mj-text color="#1F2937" padding="0px"></mj-text>
    </mj-attributes>
  </mj-head>
  <mj-body width="600px" background-color="#F3F4F6">
    <!-- rc:header-logo -->
    <mj-section background-color="#ffffff" padding="20px 24px" border-bottom="1px solid #EEF0F3">
      <mj-column>
        <mj-image src="rc-asset:logo.png" alt="%%T:logoAlt%%" width="120px" align="left" padding="0px"></mj-image>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="24px 24px 28px">
      <mj-column>
        <mj-image src="rc-asset:hero.png" alt="%%T:update.imageAlt%%" width="552px" padding="0px 0px 18px"></mj-image>
        <mj-text font-size="26px" line-height="1.2" font-weight="700" color="#0B1220" padding="0px 0px 10px"><h1 style="margin:0;font-size:26px;line-height:1.2;font-weight:700">%%T:update.headline%%</h1></mj-text>
        <mj-text font-size="15px" line-height="1.55" padding="0px 0px 18px">%%T:update.body%%</mj-text>
        <mj-button href="https://example.com/whats-new" align="left" background-color="#0F766E" color="#ffffff" font-family="'IBM Plex Sans', Helvetica, Arial, sans-serif" font-size="14px" font-weight="600" border-radius="6px" inner-padding="11px 18px" padding="0px">%%T:update.button%%</mj-button>
      </mj-column>
    </mj-section>
    <!-- rc:footer -->
    <mj-section background-color="#F3F4F6" padding="18px 24px">
      <mj-column>
        <mj-text align="center" font-family="'IBM Plex Sans', Helvetica, Arial, sans-serif" font-size="12px" line-height="1.6" color="#5B6472" padding="0px">%%ADDRESS%%<br><a href="{{ unsubscribe_url }}" style="color:#0F766E;text-decoration:none">%%T:footer.unsubscribe%%</a> · <a href="{{ preferences_url }}" style="color:#0F766E;text-decoration:none">%%T:footer.preferences%%</a> · <a href="{{ view_in_browser_url }}" style="color:#0F766E;text-decoration:none">%%T:footer.viewInBrowser%%</a></mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
