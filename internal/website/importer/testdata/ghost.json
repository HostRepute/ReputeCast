          {
            "id": "65f1c0a2b7e4d90001a3c403",
            "uuid": "0c6e4b8e-1f2a-4c1d-9b0e-000000000003",
            "title": "Founders' letter: year two",
            "slug": "founders-letter-year-two",
            "mobiledoc": null,
            "lexical": "{\"root\":{\"children\":[],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}}",
            "html": "<p>Two years ago we sent the first issue to 212 people. This letter is for the founding members who made the second year possible.</p><!--members-only--><p>Here is what we built with your support, and what comes next.</p>",
            "comment_id": "65f1c0a2b7e4d90001a3c403",
            "plaintext": "",
            "feature_image": null,
            "featured": 0,
            "type": "post",
            "status": "published",
            "locale": null,
            "visibility": "tiers",
            "email_recipient_filter": "all",
            "created_at": "2025-07-01T12:00:00.000Z",
