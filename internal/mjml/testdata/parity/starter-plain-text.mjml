<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Georgia, 'Times New Roman', serif"></mj-all>
      <mj-text color="#1F2937" font-size="15px" line-height="1.6" padding="0px 0px 14px"></mj-text>
    </mj-attributes>
  </mj-head>
  <mj-body width="600px" background-color="#ffffff">
    <mj-section background-color="#ffffff" padding="28px 24px 12px">
      <mj-column>
        <mj-text>Hi {{ first_name | default: "there" }},</mj-text>
        <mj-text>Write this the way you would write to one person: what happened, what you learned, and what you would like them to do next.</mj-text>
        <mj-text>A second paragraph with the detail. Short paragraphs read well on phones.</mj-text>
        <mj-text>Thanks for reading,<br>Your name</mj-text>
      </mj-column>
    </mj-section>
    <!-- rc:footer -->
    <mj-section background-color="#ffffff" padding="12px 24px 24px" border-top="1px solid #EEF0F3">
      <mj-column>
        <mj-text align="left" font-family="'IBM Plex Sans', Helvetica, Arial, sans-serif" font-size="12px" line-height="1.6" color="#5B6472" padding="0px">Acme Inc · 500 Market St, Suite 1200 · San Francisco, CA 94105<br><a href="{{ unsubscribe_url }}" style="color:#0F766E;text-decoration:none">Unsubscribe</a> · <a href="{{ preferences_url }}" style="color:#0F766E;text-decoration:none">Email preferences</a></mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
