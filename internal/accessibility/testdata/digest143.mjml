<mjml>
  <mj-head>
    <mj-title>Scheduled rollouts, faster exports, and 6 weeks left on the v1 API</mj-title>
    <mj-preview>Plan a flag change for 2 a.m. and sleep through it.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Georgia, 'Times New Roman', serif"></mj-all>
      <mj-text color="#1F2937" padding="0px"></mj-text>
    </mj-attributes>
  </mj-head>
  <mj-body width="600px" background-color="#F3F4F6">
    <!-- rc:header-logo -->
    <mj-section background-color="#ffffff" padding="20px 24px" border-bottom="1px solid #EEF0F3">
      <mj-column width="40%" vertical-align="middle">
        <mj-image src="https://media.example/acme-logo.png" href="https://acme.io" alt="Acme" width="96px" height="28px" align="left" padding="0px"></mj-image>
      </mj-column>
      <mj-column width="60%" vertical-align="middle">
        <mj-text align="right" font-size="12px" color="#5B6472"><a href="https://acme.io/blog" style="color:#5B6472;text-decoration:none">Blog</a> · <a href="https://docs.acme.io" style="color:#5B6472;text-decoration:none">Docs</a> · <a href="https://acme.io/changelog" style="color:#5B6472;text-decoration:none">Changelog</a></mj-text>
      </mj-column>
    </mj-section>
    <!-- rc:hero -->
    <mj-section background-color="#ffffff" padding="20px 24px 0px">
      <mj-column>
        <mj-image src="https://media.example/scheduled-rollouts.png" width="552px" height="200px" padding="0px"></mj-image>
      </mj-column>
    </mj-section>
    <!-- rc:intro -->
    <mj-section background-color="#ffffff" padding="16px 24px 8px">
      <mj-column>
        <mj-text font-size="26px" line-height="1.2" font-weight="700" color="#0B1220" padding="0px 0px 10px"><h1 style="margin:0;font-size:26px;line-height:1.2;font-weight:700">Scheduled rollouts are here</h1></mj-text>
        <mj-text font-size="15px" line-height="1.55">Hi {{ first_name | default: "there" }}, you can now schedule flag changes ahead of time, in any timezone. <a href="https://docs.acme.io/scheduled-rollouts" style="color:#0F766E">Click here</a> to see how it works.</mj-text>
      </mj-column>
    </mj-section>
    <!-- rc:cards -->
    <mj-section background-color="#ffffff" padding="16px 24px">
      <mj-column width="50%" padding="0px 8px 0px 0px">
        <mj-image src="https://media.example/article-card.png" alt="The schedule picker in the flag editor" width="268px" height="120px" padding="0px 0px 10px"></mj-image>
        <mj-text font-size="17px" line-height="1.3" font-weight="700" color="#0B1220" padding="0px 0px 6px"><h3 style="margin:0;font-size:17px;line-height:1.3;font-weight:700">Scheduled rollouts</h3></mj-text>
        <mj-text font-size="14px" line-height="1.5" color="#374151" padding="0px 0px 10px">Pick the minute a flag changes. Every scheduled change shows in the audit log.</mj-text>
        <mj-button href="https://docs.acme.io/scheduled-rollouts" align="left" background-color="#0F766E" color="#ffffff" font-size="13px" font-weight="600" border-radius="6px" inner-padding="9px 14px" padding="0px">Read the docs</mj-button>
      </mj-column>
      <mj-column width="50%" padding="0px 0px 0px 8px">
        <mj-image src="https://media.example/article-card.png" alt="The CSV export dialog" width="268px" height="120px" padding="0px 0px 10px"></mj-image>
        <mj-text font-size="17px" line-height="1.3" font-weight="700" color="#0B1220" padding="0px 0px 6px"><h3 style="margin:0;font-size:17px;line-height:1.3;font-weight:700">Faster CSV exports</h3></mj-text>
        <mj-text font-size="14px" line-height="1.5" color="#374151" padding="0px 0px 10px">Exports of up to a million rows now finish in under a minute.</mj-text>
        <mj-button href="https://acme.io/changelog" align="left" background-color="#0F766E" color="#ffffff" font-size="13px" font-weight="600" border-radius="6px" inner-padding="9px 14px" padding="0px">See the changelog</mj-button>
      </mj-column>
    </mj-section>
    <!-- rc:v1-API -->
    <mj-section background-color="#ffffff" padding="16px 24px 8px">
      <mj-column>
        <mj-text font-size="17px" line-height="1.3" font-weight="700" color="#0B1220" padding="0px 0px 6px">6 weeks left on the v1 API</mj-text>
        <mj-text font-size="15px" line-height="1.55">The v1 API stops answering on 30 November. Migration guide: <a href="https://docs.acme.io/migrate-v2" style="color:#0F766E">https://docs.acme.io/migrate-v2</a></mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="16px 24px">
      <mj-column>
        <mj-button href="https://docs.acme.io/migrate-v2/plan" align="center" background-color="#5EBFB0" color="#ffffff" font-size="15px" font-weight="700" border-radius="6px" inner-padding="12px 22px" padding="0px">Plan your migration</mj-button>
      </mj-column>
    </mj-section>
    <mj-raw><table align="center" cellpadding="0" cellspacing="0" border="0" style="margin:0 auto;background:#ffffff;width:600px"><tr><td style="padding:12px 6px" align="center"><a href="https://x.com/acme"><img src="https://media.example/social-x.png" alt="Acme on X" width="28" height="28" style="display:block;border:0"></a></td><td style="padding:12px 6px" align="center"><a href="https://www.linkedin.com/company/acme"><img src="https://media.example/social-linkedin.png" alt="Acme on LinkedIn" width="28" height="28" style="display:block;border:0"></a></td><td style="padding:12px 6px" align="center"><a href="https://github.com/acme"><img src="https://media.example/social-github.png" alt="Acme on GitHub" width="28" height="28" style="display:block;border:0"></a></td></tr></table></mj-raw>
    <!-- rc:footer -->
    <mj-section background-color="#F3F4F6" padding="18px 24px">
      <mj-column>
        <mj-text align="center" font-size="11px" line-height="1.6" color="#5B6472">Acme Inc · 500 Market St, Suite 1200 · San Francisco, CA 94105<br><a href="{{ unsubscribe_url }}" style="color:#0F766E;text-decoration:none">Unsubscribe</a> · <a href="{{ preferences_url }}" style="color:#0F766E;text-decoration:none">Email preferences</a> · <a href="{{ view_in_browser_url }}" style="color:#0F766E;text-decoration:none">View in browser</a></mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
